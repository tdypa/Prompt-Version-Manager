{
  "name": "prompt-version-manager",
  "version": "1.0.0",
  "description": "Desktop prompt version manager MVP",
  "main": "dist-electron/electron/main.js",
  "scripts": {
    "dev:renderer": "vite",
    "build:renderer": "vite build",
    "build:electron": "tsc -p tsconfig.electron.json",
    "build": "npm run build:renderer && npm run build:electron",
    "dev": "concurrently -k \"npm run dev:renderer\" \"wait-on http-get://localhost:5173 && npm run dev:electron\"",
    "dev:electron": "cross-env NODE_ENV=development electron dist-electron/electron/main.js",
    "start": "cross-env NODE_ENV=production electron dist-electron/electron/main.js",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.electron.json",
    "package": "npm run build && electron-builder"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tdypa/Prompt-Version-Manager.git"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/tdypa/Prompt-Version-Manager/issues"
  },
  "homepage": "https://github.com/tdypa/Prompt-Version-Manager#readme",
  "build": {
    "appId": "com.pvm.desktop",
    "productName": "Prompt Version Manager",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "dist-electron/**",
      "node_modules/**",
      "package.json"
    ]
  },
  "dependencies": {
    "archiver": "^7.0.1",
    "electron": "^41.2.0",
    "marked": "^18.0.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "sql.js": "^1.14.1",
    "uuid": "^13.0.0"
  },
  "devDependencies": {
    "@types/archiver": "^6.0.4",
    "@types/node": "^25.6.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/sql.js": "^1.4.11",
    "@vitejs/plugin-react": "^6.0.1",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron-builder": "^26.8.1",
    "typescript": "^6.0.2",
    "vite": "^8.0.8",
    "wait-on": "^9.0.5"
  }
}
