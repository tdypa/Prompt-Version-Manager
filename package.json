{
  "name": "prompt-version-manager",
  "version": "1.0.0",
  "description": "A desktop prompt version management tool",
  "main": "dist/main/index.js",
  "scripts": {
    "dev": "concurrently \"npm run dev:renderer\" \"npm run dev:main\"",
    "dev:renderer": "vite",
    "dev:main": "wait-on http://localhost:5173 && tsc -p tsconfig.main.json && tsc -p tsconfig.preload.json && electron . --dev",
    "build": "tsc -p tsconfig.main.json && tsc -p tsconfig.preload.json && vite build",
    "build:main": "tsc -p tsconfig.main.json && tsc -p tsconfig.preload.json",
    "preview": "electron .",
    "rebuild": "electron-rebuild -f -w better-sqlite3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tdypa/Prompt-Version-Manager.git"
  },
  "keywords": ["prompt", "version-manager", "electron"],
  "author": "",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/tdypa/Prompt-Version-Manager/issues"
  },
  "homepage": "https://github.com/tdypa/Prompt-Version-Manager#readme",
  "devDependencies": {
    "@types/archiver": "^6.0.0",
    "@types/better-sqlite3": "^7.6.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-react": "^4.0.0",
    "concurrently": "^9.0.0",
    "electron": "^35.0.0",
    "electron-builder": "^25.0.0",
    "electron-rebuild": "^3.0.0",
    "typescript": "^5.0.0",
    "vite": "^6.0.0",
    "wait-on": "^8.0.0"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "archiver": "^7.0.0",
    "better-sqlite3": "^11.0.0",
    "lucide-react": "^0.400.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^9.0.0",
    "remark-gfm": "^4.0.0",
    "tailwindcss": "^4.0.0",
    "uuid": "^11.0.0"
  }
}
